<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="dms_field.View">
        <!--
            Wrap Layout in the controller root div carrying props.className, like
            every standard Odoo controller (list/form/kanban). In a full-page
            action this className includes "o_view_controller o_action", which
            the webclient sizes as flex-column / height:100% / overflow:hidden
            and scopes ".o_action .o_content { height:100%; overflow:auto }" to.
            Without this wrapper the control panel + content had no bounded
            height and scrolled together; with it the control panel stays fixed
            and only .o_content (the list) scrolls. In an x2many sub-view
            (task Documents tab) the className has no "o_action", so the div is
            inert and the field container bounds it exactly as before.
        -->
        <div t-att-class="props.className" t-ref="root">
            <Layout display="props.display" className="'flex-grow-1 overflow-auto'">
                <!--
                    `options` carries the per-usage configuration (preview
                    navigation, open-all-folders, files-only); see
                    dms_renderer_options.esm. It replaces the former
                    openAllFolders="resModel === 'project.task'" here, which
                    never fired: this is the full-view controller, where
                    resModel is dms.storage / dms.directory. The task Documents
                    tab goes through X2ManyField instead, and can now ask for it
                    with options="{'open_all_folders': True}".
                -->
                <t
                    t-component="props.Renderer"
                    rendererActions="rendererActions"
                    explorer="props.explorer"
                    explorerSearchModel="props.explorerSearchModel"
                    options="dmsRendererOptions"
                />
            </Layout>
        </div>
    </t>
</templates>
