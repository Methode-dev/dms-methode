<?xml version="1.0" encoding="UTF-8" ?>
<!--
    File Explorer: a standalone duplicate of the base "Files" page
    (dms.action_dms_file). It intentionally mirrors that action exactly
    (same model, view modes, domain and help) so it currently behaves and
    looks identical. It exists as an independent action + menu so we can later
    bind dedicated, customised views to it (via view_ids) without touching the
    original File page — which now lives under Configuration > Documents.
-->
<odoo>
    <record id="action_dms_file_explorer" model="ir.actions.act_window">
        <field name="name">File Explorer</field>
        <field name="res_model">dms.file</field>
        <!-- Kanban only: a basic-user exploration/preview view. No form (file
             configuration), and no list/graph/pivot. -->
        <field name="view_mode">kanban</field>
        <field name="domain">[("is_hidden", "=", False)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new File.
            </p>
            <p>
                Files are used to save content directly in Odoo.
            </p>
        </field>
    </record>

    <!--
        Dedicated kanban for File Explorer: a primary view inheriting the base
        file kanban, only swapping its js_class so the click-anywhere-to-preview
        behaviour (file_explorer_kanban) applies here without affecting the
        original File page. This is the customisation entry point — diverge the
        arch further here as the custom view evolves.
    -->
    <record id="view_dms_file_explorer_kanban" model="ir.ui.view">
        <field name="name">dms.file.kanban.explorer</field>
        <field name="model">dms.file</field>
        <field name="inherit_id" ref="dms.view_dms_file_kanban" />
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban position="attributes">
                <attribute name="js_class">file_explorer_kanban</attribute>
                <!-- Read-only explorer for basic users: no create/upload, no
                     inline edit, no delete/archive. -->
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
                <!-- OS-file-explorer tile layout (see file_explorer.scss). -->
                <attribute name="class" add="o_file_explorer_kanban" separator=" " />
            </kanban>
            <!-- Remove the card manage dropdown (the 3-dots). In File Explorer:
                 double-click a file to preview it, right-click to download it
                 (both handled by the file_explorer_kanban record). -->
            <xpath expr="//t[@t-name='menu']" position="replace" />
            <!-- OS-file-explorer card: the icon centred in an (invisible) square
                 box, with the file name displayed below it. -->
            <xpath expr="//t[@t-name='card']" position="replace">
                <t t-name="card">
                    <main class="o_file_explorer_card">
                        <div class="o_file_explorer_icon">
                            <img t-att-src="record.icon_url.raw_value" alt="Icon" />
                        </div>
                        <div class="o_file_explorer_name">
                            <field name="name" widget="dms_filename_truncate" />
                        </div>
                    </main>
                </t>
            </xpath>
        </field>
    </record>

    <!-- Bind the dedicated kanban to the File Explorer action; the other view
         modes (list/graph/pivot/form) fall back to the model defaults. -->
    <record
        id="action_dms_file_explorer_kanban_view"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="1" />
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_dms_file_explorer_kanban" />
        <field name="act_window_id" ref="action_dms_file_explorer" />
    </record>

    <!--
        Top-level tab in the Documents app, back where "Files" used to sit.
        The lowest top-level sequence (10, below Configuration at 50 and the
        Documents storage view at 99) makes this the default landing page when
        the Documents app is opened.
    -->
    <menuitem
        id="menu_dms_file_explorer"
        name="File Explorer"
        parent="dms.main_menu_dms"
        sequence="10"
        action="action_dms_file_explorer"
    />
</odoo>
