<odoo>
    <record id="view_task_form_pdf_merge" model="ir.ui.view">
        <field name="name">project.task.form.pdf.merge</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="pdf_merge_button_visible" invisible="1" />
                <button name="action_open_pdf_merge"
                        type="object"
                        string="Merge PDF"
                        icon="fa-files-o"
                        invisible="not pdf_merge_button_visible" />
            </xpath>
        </field>
    </record>
</odoo>
