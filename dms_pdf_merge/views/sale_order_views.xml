<odoo>
    <record id="sale_order_form_pdf_merge" model="ir.ui.view">
        <field name="name">sale.order.form.pdf.merge</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="pdf_merge_button_visible" invisible="1" />
                <button name="action_open_pdf_merge"
                        type="object"
                        string="Merge PDF"
                        icon="fa-files-o"
                        invisible="not pdf_merge_button_visible" />
            </xpath>
        </field>
    </record>
</odoo>
